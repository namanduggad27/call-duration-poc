<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Avatar circle -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
            android:id="@+id/ivSearchAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_favorite_avatar"
            android:padding="10dp"
            android:src="@drawable/ic_call" />

        <TextView
            android:id="@+id/tvSearchInitials"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_favorite_avatar"
            android:gravity="center"
            android:textColor="#58A6FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Name and Number -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSearchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Name"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSearchNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+1 234 567 890"
            android:textColor="#8B949E"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Call Button -->
    <ImageButton
        android:id="@+id/btnSearchCall"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_call_button"
        android:contentDescription="Call"
        android:padding="9dp"
        android:src="@drawable/ic_call" />

</LinearLayout>
